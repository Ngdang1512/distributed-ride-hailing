<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RideHailing.Mobile.MainPage"
             Title="Đặt chuyến"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" BackgroundColor="#e8eaed">
            <Image Source="map_placeholder.png" Aspect="AspectFill" Opacity="0.5"/>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label Text="📍" FontSize="60"/>
                <Label Text="Vị trí của bạn trên bản đồ" 
                       TextColor="#555" FontSize="18" FontAttributes="Bold"/>
            </VerticalStackLayout>
            
            <ImageButton Source="back_icon.png" 
                         HorizontalOptions="Start" VerticalOptions="Start" 
                         Margin="20,50,0,0" HeightRequest="40" WidthRequest="40"
                         BackgroundColor="White" CornerRadius="20"
                         Clicked="OnBackClicked"/>
        </Grid>

        <Border Grid.Row="1" StrokeShape="RoundRectangle 25,25,0,0" 
                BackgroundColor="White" Padding="25"
                Shadow="{Shadow Brush=Black, Offset='0,-5', Opacity=0.1}">
            
            <VerticalStackLayout Spacing="15">
                <Label Text="Bạn đang ở đâu?" FontSize="14" TextColor="Gray"/>

                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="lblAddress" 
                               Text="Chưa xác định vị trí" 
                               FontSize="18" FontAttributes="Bold" TextColor="Black"
                               LineBreakMode="TailTruncation"/>
                        <Label x:Name="lblRegion" 
                               Text="Vui lòng bấm định vị..." 
                               FontSize="13" TextColor="#00bf63"/>
                    </VerticalStackLayout>
                    
                    <ImageButton Grid.Column="1" 
                                 Source="gps_icon.png" 
                                 BackgroundColor="#e0f2f1" 
                                 CornerRadius="25"
                                 HeightRequest="50" WidthRequest="50"
                                 Clicked="OnGetLocationClicked"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#f1f1f1" Margin="0,5"/>

                <HorizontalStackLayout IsVisible="False">
                    <Entry x:Name="txtLat" Text="0"/>
                    <Entry x:Name="txtLng" Text="0"/>
                </HorizontalStackLayout>

                <Label x:Name="lblStatus" Text="Sẵn sàng" TextColor="Gray" HorizontalOptions="Center" FontSize="12"/>

                <Button x:Name="btnBook" 
                        Text="🚘 ĐẶT XE NGAY" 
                        BackgroundColor="#00bf63" TextColor="White" 
                        HeightRequest="55" CornerRadius="28" 
                        FontAttributes="Bold" FontSize="16"
                        Clicked="OnBookBtnClicked"/>

                <Button x:Name="btnFinish" 
                        Text="🏁 HOÀN THÀNH CHUYẾN" 
                        BackgroundColor="#ff3b30" TextColor="White" 
                        HeightRequest="55" CornerRadius="28" 
                        FontAttributes="Bold" FontSize="16"
                        IsVisible="False"
                        Clicked="OnFinishBtnClicked"/>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>